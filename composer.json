{
	"name": "craue/translations-tests",
	"description": "Common code for testing translations in your Symfony project.",
	"license": "MIT",
	"type": "library",
	"keywords": [
		"symfony",
		"testing",
		"translations"
	],
	"authors": [
		{
			"name": "Christian Raue",
			"email": "christian.raue@gmail.com"
		},
		{
			"name": "Symfony Community",
			"homepage": "https://github.com/craue/CraueTranslationsTests/contributors"
		}
	],
	"homepage": "https://github.com/craue/CraueTranslationsTests",
	"require": {
		"php": "^8.2",
		"phpunit/phpunit": "^11.5.50 || ^12.5.8 || ^13.3",
		"symfony/translation": "^5.4 || ^6.4 || ^7.4 || ^8.1",
		"symfony/yaml": "^5.4 || ^6.4 || ^7.4 || ^8.1"
	},
	"require-dev": {
		"phpstan/extension-installer": "^1.1",
		"phpstan/phpstan": "^2.2",
		"phpstan/phpstan-deprecation-rules": "^2",
		"phpstan/phpstan-strict-rules": "^2",
		"phpstan/phpstan-symfony": "^2",
		"symfony/phpunit-bridge": "^8.1"
	},
	"minimum-stability": "stable",
	"autoload": {
		"psr-4": {
			"Craue\\TranslationsTests\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Craue\\TranslationsTests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		},
		"sort-packages": true
	},
	"extra": {
		"branch-alias": {
			"dev-master": "2.0.x-dev"
		}
	}
}
